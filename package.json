{
  "name": "google-mcp-suite",
  "version": "1.1.0",
  "type": "module",
  "description": "Per-account MCP servers for Gmail, Google Calendar, and Google Sheets: identity is bound to the running instance, so an agent can never act on the wrong account; each server exposes the curated MCP toolset plus the broader REST surface.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "gmail",
    "google",
    "oauth",
    "multi-account",
    "agent",
    "email",
    "calendar",
    "google-calendar",
    "scheduling",
    "sheets",
    "google-sheets",
    "spreadsheet"
  ],
  "author": "the-simian <info@simiancraft.com>",
  "license": "MIT",
  "homepage": "https://github.com/simiancraft/google-mcp-suite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simiancraft/google-mcp-suite.git"
  },
  "bugs": {
    "url": "https://github.com/simiancraft/google-mcp-suite/issues"
  },
  "bin": {
    "google-mcp-gmail": "./dist/gmail/index.js",
    "google-mcp-calendar": "./dist/calendar/index.js",
    "google-mcp-sheets": "./dist/sheets/index.js",
    "google-mcp-doctor": "./dist/doctor/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write .",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "capabilities": "bun run src/gmail/capabilities.ts && bun run src/calendar/capabilities.ts && bun run src/sheets/capabilities.ts",
    "doctor": "bun run src/doctor/index.ts",
    "tokens": "bun run src/doctor/index.ts status",
    "reauth": "bun run src/doctor/index.ts auth",
    "check:knip": "knip",
    "check": "bun run lint:fix && bun run build && bun run typecheck && bun test --coverage && bun run check:knip",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@googleapis/calendar": "^15.0.0",
    "@googleapis/gmail": "^17.0.0",
    "@googleapis/sheets": "^13.0.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "addressparser": "^1.0.1",
    "google-auth-library": "^10.5.0",
    "mail-mime-builder": "^1.0.1",
    "open": "^11.0.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5",
    "@types/addressparser": "^1.0.3",
    "@types/bun": "^1.3.13",
    "fast-check": "^4.8.0",
    "knip": "^6.14.0",
    "semantic-release": "^25.0.5",
    "typescript": "^6.0.0"
  }
}
